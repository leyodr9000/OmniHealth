<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OmniHealth" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/omni_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.OmniHealth.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/omni_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.OmniHealth</item>
    </style>
</resources>
